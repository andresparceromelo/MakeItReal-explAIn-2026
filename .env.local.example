# Primary AI provider: groq | gemini | openrouter | openai | custom (defaults to groq first)
# AI_PROVIDER=groq
# Optional fallback order:
# AI_FALLBACK_ORDER=groq,gemini,openrouter,openai,custom

# Groq (Primary - ultra-fast free tier)
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (Automatic fallback or primary when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI (Optional)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# OpenRouter (Optional)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Any Custom OpenAI-Compatible Provider (Cerebras, Together, Mistral, Ollama, etc.)
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=your_custom_api_key_here
# AI_MODEL=your_model_name
